<Window x:Class="CreativeHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Creative Hub" Height="650" Width="1000"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen">

    <!-- Главная подложка приложения. Здесь задаем цвет и скругление -->
    <Border Background="#1E1E1E" CornerRadius="16" Margin="15">

        <!-- Добавляем мягкую тень вокруг окна -->
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.4" Color="Black"/>
        </Border.Effect>

        <!-- Сетка для разделения верхней панели и основной рабочей зоны -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="45"/>
                <!-- Наша кастомная верхняя панель (Title Bar) -->
                <RowDefinition Height="*"/>
                <!-- Основной контент -->
            </Grid.RowDefinitions>

            <!-- Верхняя панель (по ней будем перетаскивать окно) -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <!-- Название приложения -->
                <TextBlock Text="Hub" Foreground="#888888" VerticalAlignment="Center" Margin="20,0,0,0" FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold"/>

                <!-- Кнопка закрытия -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,15,0">
                    <Button Content="✕" Width="30" Height="30" Background="Transparent" Foreground="#888888" BorderThickness="0" FontSize="14" Click="CloseButton_Click" Cursor="Hand"/>
                </StackPanel>
            </Grid>

            <!-- Заглушка для основного контента (Сюда потом добавим доску с карточками) -->
            <Grid Grid.Row="1" Margin="20">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Здесь будет доска задач" Foreground="#555555" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="Например: Апскейл в Topaz, настройка Sapphire или таймкоды для эдита Леона" Foreground="#444444" FontSize="14" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
